---
import Flag from './Flag.astro';
import Canton from './Canton.astro';

const { period, title, org, role, entries, flag, canton } = Astro.props;
---

<article class="incident">
  <div class="incident-marker" aria-hidden="true"></div>
  <div class="incident-body">
    <p class="incident-period">{period}</p>
    <h3 class="incident-title">{title}</h3>
    {/* The country is already spelled out in `org`, so the flag is decoration only. */}
    <p class="incident-meta">{role} · {flag && <Flag country={flag} label={false} />}{canton && <Canton canton={canton} />}{org}</p>
    <ul class="incident-entries">
      {entries.map((entry) => <li>{entry}</li>)}
    </ul>
  </div>
</article>

<style>
  .incident {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: 0.75rem;
    position: relative;
  }
  .incident-marker {
    position: relative;
  }
  .incident-marker::before {
    content: '';
    position: absolute;
    top: 0.4rem;
    left: 50%;
    transform: translateX(-50%);
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 3px var(--ok-bg);
  }
  .incident-marker::after {
    content: '';
    position: absolute;
    top: 1.4rem;
    bottom: -1.6rem;
    left: 50%;
    transform: translateX(-50%);
    width: 2px;
    background: var(--border);
  }
  .incident:last-child .incident-marker::after {
    display: none;
  }
  .incident-body {
    padding-bottom: 2rem;
  }
  .incident-period {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .incident-title {
    margin: 0.2rem 0 0.1rem;
    font-size: 1.1rem;
  }
  .incident-meta {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    color: var(--accent);
    font-weight: 500;
  }
  .incident-entries {
    margin: 0;
    padding-left: 1.1rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .incident-entries li {
    margin-bottom: 0.25rem;
  }
</style>
