---
// Simplified Swiss canton arms, sized to sit next to the country flags.
// These are stylized on purpose: at 14px the real blazons (Valais' thirteen
// stars, Vaud's motto, Geneva's half eagle) turn to mush, so each icon keeps
// only its colours and main charge. The canton name is in the aria-label,
// unless the surrounding text already names it, in which case pass label={false}.
const { canton, size = 14, label } = Astro.props;

const names = {
  vs: 'Canton of Valais',
  vd: 'Canton of Vaud',
  ge: 'Canton of Geneva',
};
---

<svg
  class="canton"
  viewBox="0 0 32 32"
  width={size}
  height={size}
  role={label === false ? undefined : 'img'}
  aria-label={label === false ? undefined : names[canton]}
  aria-hidden={label === false ? 'true' : undefined}
  focusable="false"
>
  {canton === 'vs' && (
    <>
      <rect width="32" height="32" rx="6" fill="#fff"></rect>
      <path d="M16 0h10a6 6 0 0 1 6 6v20a6 6 0 0 1-6 6H16z" fill="#d52b1e"></path>
      <g fill="#d52b1e">
        <circle cx="6" cy="8" r="1.7"></circle>
        <circle cx="11" cy="16" r="1.7"></circle>
        <circle cx="6" cy="24" r="1.7"></circle>
      </g>
      <g fill="#fff">
        <circle cx="26" cy="8" r="1.7"></circle>
        <circle cx="21" cy="16" r="1.7"></circle>
        <circle cx="26" cy="24" r="1.7"></circle>
      </g>
    </>
  )}
  {canton === 'vd' && (
    <>
      <rect width="32" height="32" rx="6" fill="#fff"></rect>
      <path d="M0 16h32v10a6 6 0 0 1-6 6H6a6 6 0 0 1-6-6z" fill="#007a33"></path>
    </>
  )}
  {canton === 'ge' && (
    <>
      <rect width="32" height="32" rx="6" fill="#ffcc00"></rect>
      <path d="M16 0h10a6 6 0 0 1 6 6v20a6 6 0 0 1-6 6H16z" fill="#d52b1e"></path>
      {/* Half eagle, reduced to a silhouette */}
      <path d="M5 24V8h7l-2.5 3.5 3.5 1.5-3.5 2 3.5 2-4 1.5 2 5.5z" fill="#1a1a1a"></path>
      {/* Key */}
      <g fill="#ffcc00">
        <circle cx="24" cy="10" r="3.2"></circle>
        <rect x="22.9" y="12" width="2.2" height="12"></rect>
        <rect x="25.1" y="16" width="4" height="2"></rect>
        <rect x="25.1" y="20" width="4" height="2"></rect>
      </g>
    </>
  )}
</svg>

<style>
  .canton {
    vertical-align: -0.15em;
    margin-right: 0.35rem;
    border-radius: 2px;
  }
</style>
