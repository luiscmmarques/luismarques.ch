---
import Glyph from './Glyph.astro';
import Canton from './Canton.astro';

const { name, status, note, icon, cantons } = Astro.props;

const labels = {
  operational: 'Operational',
  degraded: 'Degraded',
  elevated: 'Elevated',
  maintenance: 'Maintenance',
};
---

<div class="row" data-status={status}>
  <div class="row-main">
    <span class="row-name">
      {icon && (
        <span class="row-glyph">
          <Glyph name={icon} />
        </span>
      )}
      {name}
    </span>
    <span class:list={['badge', status]}>{labels[status]}</span>
  </div>
  {/* Cantons are named in the note, so the arms are extra flavour, not information. */}
  <p class="row-note">
    {cantons && (
      <span class="row-cantons">
        {cantons.map((c) => <Canton canton={c} label={false} />)}
      </span>
    )}{note}
  </p>
</div>

<style>
  .row {
    padding: 0.9rem 1.1rem;
    border-bottom: 1px solid var(--border);
  }
  .row:last-child {
    border-bottom: none;
  }
  .row-main {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .row-name {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
  }
  .row-note {
    margin: 0.25rem 0 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .row-cantons {
    display: inline-flex;
    align-items: center;
    vertical-align: -0.15em;
  }
  /* Wrapper, not the svg: scoped styles do not reach into a child component,
     and currentColor inherits from here into the glyph's strokes. */
  .row-glyph {
    display: inline-flex;
    color: var(--ok);
  }
  .row[data-status='elevated'] .row-glyph,
  .row[data-status='degraded'] .row-glyph {
    color: var(--warn);
  }
  .row[data-status='maintenance'] .row-glyph {
    color: var(--info);
  }
  .badge {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .badge::before {
    content: '●';
    margin-right: 0.35rem;
    font-size: 0.65rem;
  }
  .operational {
    color: var(--ok);
    background: var(--ok-bg);
  }
  .elevated {
    color: var(--warn);
    background: var(--warn-bg);
  }
  .degraded {
    color: var(--warn);
    background: var(--warn-bg);
  }
  .maintenance {
    color: var(--info);
    background: var(--info-bg);
  }
</style>
